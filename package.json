    "@types/express": "5.0.6",
    "@types/node": "26.6.5",
    "@types/supertest": "7.2.1",
    "@vitest/coverage-v8": "5.0.5",
    "@vitest/ui": "5.0.5",
    "cross-env": "10.1.0",
    "supertest": "7.3.1",
    "ts-node": "10.9.2",
    "ts-node-dev": "2.0.0",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
